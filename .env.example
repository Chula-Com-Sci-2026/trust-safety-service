JWT_SECRET=configure-shared-local-secret
DATABASE_URL=postgresql://service:password@localhost:5432/service
# Comma-separated account UUIDs allowed to moderate. Empty means nobody can.
MODERATOR_IDS=
# Full URL of Identity's account-lock operation. Empty records suspensions without locking.
IDENTITY_LOCK_URL=
AMQP_URL=amqp://user:password@localhost:5672/
BROKER_HTTP_URL=http://localhost:15672
BROKER_USER=user
BROKER_PASSWORD=password
